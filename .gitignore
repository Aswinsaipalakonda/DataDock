# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# hostinger
*.log
/server/uploads/*
/backups/*
!/backups/.gitkeep

# deployment archives
*.zip
*.tar.gz
brag-output/
/data/
/data/*
/HOSTINGER_DEPLOYMENT.md

# local runtime data
.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local credentials
creds.md
